#!/bin/sh
# ReqToCode pre-commit gate: requirement sources must parse, generated traceables
# (SWR.g.cs) must be current, and every approved requirement with a required trace
# must be referenced in code. See Docs/requirements/README.md.
#
# Enable once per clone:  git config core.hooksPath Tools/git-hooks

repo_root="$(git rev-parse --show-toplevel)"
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Tools/reqtocode/Check-ReqToCode.ps1"
